# Supabase (mismo proyecto que WIOCRM)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ID de la cuenta de Camilo en WIOCRM
NEXT_PUBLIC_WIOCRM_ACCOUNT_ID=88cf5ef8-5803-461b-b0c3-ed8905977337

# Identidad pública del nutricionista
NEXT_PUBLIC_NUTRI_NOMBRE="Camilo Villafranca"
NEXT_PUBLIC_NUTRI_WHATSAPP="51952686162"

# IA (DeepSeek) — SOLO en rutas del servidor (src/app/api/...), NUNCA en el cliente
DEEPSEEK_API_KEY=sk-...
# ID vigente del modelo con capacidad de visión (verificado en api-docs.deepseek.com)
DEEPSEEK_MODELO_VISION=deepseek-flash

# Tope mensual de fotos revisadas por IA por cuenta (por defecto 10000)
IA_TOPE_FOTOS_MES=10000

# Modo demo: 1 SOLO en local para ver las pantallas sin Supabase. NUNCA en el sitio real.
NEXT_PUBLIC_DEMO_MODE=

# Clave service_role de WIOCRM (Supabase > Project Settings > API). SOLO en el servidor (Vercel, sin NEXT_PUBLIC_).
# Se usa únicamente para guardar las fotos en el bucket privado nutri-fotos.
SUPABASE_SERVICE_ROLE_KEY=
